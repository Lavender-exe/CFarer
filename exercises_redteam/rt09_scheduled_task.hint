=== HINT 1: COM init + service (all COM boilerplate) ===
CoInitializeEx(NULL, COINIT_MULTITHREADED);
VARIANT empty; VariantInit(&empty);
CoInitializeSecurity(NULL,-1,NULL,NULL,RPC_C_AUTHN_LEVEL_PKT,
    RPC_C_IMP_LEVEL_IMPERSONATE,NULL,0,NULL);
CoCreateInstance(CLSID_TaskScheduler, NULL, CLSCTX_INPROC_SERVER,
    IID_ITaskService, (void**)&pSvc);
ITaskService_Connect(pSvc, empty, empty, empty, empty);
ITaskService_NewTask(pSvc, 0, &pTask);

=== HINT 2: Logon trigger + exec action ===
ITriggerCollection *pTriggers; ITaskDefinition_get_Triggers(pTask, &pTriggers);
ITrigger *pTrig; ITriggerCollection_Create(pTriggers, TASK_TRIGGER_LOGON, &pTrig);
ILogonTrigger *pLogon;
ITrigger_QueryInterface(pTrig, IID_ILogonTrigger, (void**)&pLogon);
IActionCollection *pActions; ITaskDefinition_get_Actions(pTask, &pActions);
IAction *pAct; IActionCollection_Create(pActions, TASK_ACTION_EXEC, &pAct);
IExecAction *pExec; IAction_QueryInterface(pAct, IID_IExecAction, (void**)&pExec);
// convert exe_path to BSTR and IExecAction_put_Path(pExec, bstr_path)

=== HINT 3: Register + delete (use the same `empty` VARIANT) ===
ITaskService_GetFolder(pSvc, SysAllocString(L"\\"), &pFolder);
ITaskFolder_RegisterTaskDefinition(pFolder, SysAllocString(L"CFarerTest"), pTask,
    TASK_CREATE_OR_UPDATE, empty, empty, TASK_LOGON_INTERACTIVE_TOKEN, empty, NULL);
// cleanup:
ITaskFolder_DeleteTask(pFolder, SysAllocString(L"CFarerTest"), 0);

=== KEY INSIGHT ===
Scheduled tasks survive reboots, run as specific users/SYSTEM, harder to spot than Run keys.
schtasks.exe /create is a LOLBin equivalent (no COM needed, leaves same artifacts).
Detection: Sysmon EventID 1 (process create from taskeng.exe/taskhostw.exe),
  Task Scheduler operational log, Autoruns.
Hidden tasks: create under subfolders or use names mimicking system tasks
  ("MicrosoftEdgeUpdateTask", "GoogleUpdateTask").
Remote task creation: pSvc->Connect(L"\\\\target", creds...) - same API, lateral movement.
