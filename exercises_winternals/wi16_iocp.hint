=== HINT 1: Create port + worker loop ===
HANDLE port = CreateIoCompletionPort(INVALID_HANDLE_VALUE, NULL, 0, NUM_WORKERS);
BOOL ok = GetQueuedCompletionStatus(port, &bytes, &key, &ov, INFINITE);
if (!ok && !ov) break;        // port closed or error
if (key == SENTINEL_KEY) break;
InterlockedAdd(&g_total, (LONG)bytes);

=== HINT 2: Post tasks + sentinels ===
PostQueuedCompletionStatus(port, (DWORD)i, 1, NULL);                  // tasks
for (int i = 0; i < NUM_WORKERS; i++)
    PostQueuedCompletionStatus(port, 0, SENTINEL_KEY, NULL);          // one sentinel per worker

=== HINT 3 (KEY INSIGHT) ===
The OS wakes exactly one worker per completion. The concurrency hint prevents
more than N threads running at once. Per-notification cost is O(1) regardless
of how many file/socket handles feed the port - scales to 100k connections.
