=== HINT 1: Create + inspect ===
HANDLE mtx = CreateMutexA(NULL, FALSE, "CFarerMutex");
HANDLE evt = CreateEventA(NULL, TRUE, FALSE, "CFarerEvent");
DWORD flags;
GetHandleInformation(mtx, &flags);
printf("Mutex flags: 0x%lX  (INHERIT=%d  PROTECT=%d)\n", flags,
       (flags & HANDLE_FLAG_INHERIT) != 0,
       (flags & HANDLE_FLAG_PROTECT_FROM_CLOSE) != 0);

=== HINT 2: Inherit flag + duplicate ===
SetHandleInformation(mtx, HANDLE_FLAG_INHERIT, HANDLE_FLAG_INHERIT);
GetHandleInformation(mtx, &flags);
assert(flags & HANDLE_FLAG_INHERIT);
HANDLE evt_dup;
DuplicateHandle(GetCurrentProcess(), evt, GetCurrentProcess(), &evt_dup,
                0, FALSE, DUPLICATE_SAME_ACCESS);

=== HINT 3 (SPOILER): Aliasing + cleanup ===
SetEvent(evt);
DWORD wr = WaitForSingleObject(evt_dup, 100);
assert(wr == WAIT_OBJECT_0);   // duplicate aliases the SAME underlying object
CloseHandle(evt_dup); CloseHandle(evt); CloseHandle(mtx);
