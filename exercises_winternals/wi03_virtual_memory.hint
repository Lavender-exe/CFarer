=== HINT 1 ===
VirtualQuery loop pattern:
  while (VirtualQuery(addr, &mbi, sizeof(mbi)) == sizeof(mbi)) {
      addr += mbi.RegionSize;
      ...
  }
Only count committed pages: if (mbi.State == MEM_COMMIT) total_committed += mbi.RegionSize;

=== HINT 2 ===
Check protection with the helper functions already provided (is_exec / is_rwx).
Guard pages (PAGE_GUARD) have their permission ORed with the base protection -
mask it out: DWORD prot = mbi.Protect & ~PAGE_GUARD;

=== HINT 3 (SPOILER) ===
while (VirtualQuery(addr, &mbi, sizeof(mbi)) == sizeof(mbi)) {
    if (mbi.State == MEM_COMMIT) {
        DWORD prot = mbi.Protect & ~PAGE_GUARD;
        total_committed += mbi.RegionSize;
        if (is_exec(prot)) exec_regions++;
        if (is_rwx(prot))  rwx_regions++;
    }
    addr += mbi.RegionSize;
}
