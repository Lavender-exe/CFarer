=== HINT 1 ===
Array access: arr[i]  where i goes from 0 to len-1.
Use a for loop: for (int i = 0; i < len; i++) { ... }

=== HINT 2 ===
array_sum: start with total=0, add arr[i] each iteration.
array_max: start with max=arr[0], update if arr[i] > max.

=== HINT 3 (SPOILER) ===
int array_sum(int *arr, int len) {
    int total = 0;
    for (int i = 0; i < len; i++) total += arr[i];
    return total;
}

int array_max(int *arr, int len) {
    int max = arr[0];
    for (int i = 1; i < len; i++)
        if (arr[i] > max) max = arr[i];
    return max;
}
