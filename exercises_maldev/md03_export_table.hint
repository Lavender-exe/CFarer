=== HINT 1 ===
RVA to VA conversion:  (BYTE*)base + rva

Export directory:
  PIMAGE_EXPORT_DIRECTORY exp =
      (PIMAGE_EXPORT_DIRECTORY)((BYTE*)base + export_rva);

=== HINT 2 ===
The three arrays are also stored as RVAs:
  DWORD *names    = (DWORD*)((BYTE*)base + exp->AddressOfNames);
  WORD  *ordinals = (WORD*) ((BYTE*)base + exp->AddressOfNameOrdinals);
  DWORD *funcs    = (DWORD*)((BYTE*)base + exp->AddressOfFunctions);

For each name index i:
  const char *name = (const char*)((BYTE*)base + names[i]);
  WORD  ord        = ordinals[i];
  void *fn         = (void*)((BYTE*)base + funcs[ord]);

=== HINT 3 (SPOILER) ===
PIMAGE_EXPORT_DIRECTORY exp =
    (PIMAGE_EXPORT_DIRECTORY)((BYTE*)base + export_rva);
DWORD *names    = (DWORD*)((BYTE*)base + exp->AddressOfNames);
WORD  *ordinals = (WORD*) ((BYTE*)base + exp->AddressOfNameOrdinals);
DWORD *funcs    = (DWORD*)((BYTE*)base + exp->AddressOfFunctions);

DWORD limit = exp->NumberOfNames < 20 ? exp->NumberOfNames : 20;
for (DWORD i = 0; i < limit; i++) {
    const char *name = (const char*)((BYTE*)base + names[i]);
    void *fn = (void*)((BYTE*)base + funcs[ordinals[i]]);
    printf("%-40s  %p\n", name, fn);
}
